# ---------------------------------------------------------------- server ----
PORT=8787
# Comma-separated allowlist. Do not paste this string as one CORS header;
# the server reflects the matching origin.
CORS_ORIGIN=http://localhost:5173,https://noisy-sky-fa9c.rj838486.workers.dev
LOG_REQUESTS=true
DATABASE_PATH=./data/overflow.db

# ---------------------------------------------------------------- solana ----
# A public endpoint WILL rate-limit under real use. Use a dedicated provider
# (Helius, Triton, QuickNode) before any live demo.
SOLANA_RPC_URL=
NETWORK=mainnet-beta

# --------------------------------------------------------------- jupiter ----
# Optional for prototyping; the keyless endpoint has tight limits.
# This key stays server-side. The browser never sees it.
JUPITER_API_KEY=
JUPITER_API_BASE=https://api.jup.ag/swap/v2

# Outbound request throttle. Jupiter's free tier is 1 req/s, enforced per
# organisation (extra keys do not raise it), so requests are serialised rather
# than fired in parallel. Raise this if you move to a paid plan:
#   free 1  ·  Developer 10  ·  Launch 50  ·  Pro 150
# Leave unset to auto-select: 1 req/s with a key, 0.6 keyless (the keyless
# endpoint is stricter than the documented free-tier rate).
#JUPITER_RPS=1
# /swap/v2/execute has its own bucket at Jupiter, so signing never queues behind
# background quote traffic.
JUPITER_EXECUTE_RPS=5
# How long a route-availability probe stays cached.
JUPITER_PROBE_TTL_MS=600000

# --------------------------------------------------------------- xstocks ----
XSTOCKS_API_BASE=https://api.xstocks.fi/api/v2

# ---------------------------------------------------------------- kamino ----
# Kamino Earn USDC vault. Verified live: 18,278,326 shares issued,
# 76,810 USDC available, exchange rate 1.0586 USDC/share (September 2026).
# Used as the default when a rule is created without an explicit vault.
KAMINO_USDC_VAULT=HDsayqAsDWy3QvANGqh2yNraqcD8Fnjgh73Mhb3WRS5E
KAMINO_SHARE_DECIMALS=6

# ---------------------------------------------------------------- poller ----
# Corporate-action detection interval. Leave blank to poll only on demand
# via POST /api/poll.
POLL_INTERVAL_MS=
CRON_SECRET=

# --------------------------------------------------------------- auth -------
# HMAC key for wallet sign-in sessions. REQUIRED in production (>= 32 chars).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# -------------------------------------------------- private markets --------
# Verified live (September 2026). No API key needed.
PRESTOCKS_API_URL=https://prestocks.com/api/prestocks
TESSERA_API_URL=https://rest-api.tessera.pe/v1/public/token-details

# ------------------------------------------------------------ pyth pro -----
# Only for PYTH_PARITY firewall rules. Paid; unset means those rules fail closed.
PYTH_PRICE_API_URL=
PYTH_API_KEY=

# ------------------------------------------------- corporate actions -------
XSTOCKS_CORPORATE_ACTIONS_PATH=/public/corporate-actions/history
