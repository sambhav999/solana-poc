# Overflow — DEVNET
# Copy values into the files / dashboards named in each section.
# Do not use this file as a live .env. Frontend and backend are separate.
#
# Program id (same on every cluster if you deploy with the repo keypair):
#   nAAStFqtSRsQbuzUARufKs8URPB6sEeUhHnTDK4HqGp
#
# WHERE TO PUT WHAT
#   1. Local backend ........ backend/.env
#   2. Render backend ....... Render dashboard → Environment
#   3. Local frontend ....... frontend/.env   then restart `npm run dev`
#   4. Live frontend ........ frontend/.env   then rebuild / redeploy Workers
#      Vite inlines VITE_* at build time. Changing Render does not update the UI.
#   5. Solana CLI ........... not an env file. ~/.config/solana/id.json is the
#      deployer wallet (fees + upgrade authority). Not Phantom.
#
# The program id string belongs on the BACKEND only
# (OVERFLOW_REGISTRY_PROGRAM_ID). The frontend never needs it; Phantom signs
# the unsigned tx the API already built. Frontend only needs VITE_SOLANA_CLUSTER
# so the wallet uses solana:devnet.
#
# Jupiter / Kamino / xStocks are mainnet products. On a full-devnet backend
# harvests may fail. That is expected. create_rule / post_receipt still prove
# the registry. For a product demo, use deploy/mainnet.env after mainnet deploy.

# =============================================================================
# MUST ADD — backend/.env  AND  Render env  (same names)
# =============================================================================
OVERFLOW_REGISTRY_PROGRAM_ID=nAAStFqtSRsQbuzUARufKs8URPB6sEeUhHnTDK4HqGp
NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Sign-in sessions. REQUIRED on Render (NODE_ENV=production), >= 32 chars.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# Browser origins allowed to call the API. Comma-separated. Trailing slashes off.
CORS_ORIGIN=http://localhost:5173,https://noisy-sky-fa9c.rj838486.workers.dev

# =============================================================================
# MUST ADD — frontend/.env  (then restart Vite or rebuild Workers)
# =============================================================================
VITE_API_BASE=https://solana-poc.onrender.com/api
VITE_SOLANA_CLUSTER=devnet
VITE_EXPLORER_BASE=https://solscan.io/tx

# Local UI against a local API instead:
# VITE_API_BASE=http://localhost:8787/api

# =============================================================================
# ALREADY REQUIRED FOR THE APP — keep these, do not remove
# =============================================================================
# backend
PORT=8787
KAMINO_USDC_VAULT=HDsayqAsDWy3QvANGqh2yNraqcD8Fnjgh73Mhb3WRS5E
KAMINO_SHARE_DECIMALS=6
DATABASE_PATH=./data/overflow.db

# =============================================================================
# OPTIONAL — leave blank unless you have them
# =============================================================================
# JUPITER_API_KEY=
# PYTH_PRICE_API_URL=
# PYTH_API_KEY=
# POLL_INTERVAL_MS=
# CRON_SECRET=

# =============================================================================
# DO NOT PUT IN ANY ENV FILE
# =============================================================================
# programs/overflow-registry/keys/overflow_registry-keypair.json
#   = program address. Needed to deploy/upgrade this program id.
# ~/.config/solana/id.json
#   = CLI wallet that pays deploy fees. Never commit. Never paste into Render.
# Phantom private key
#   = user signing only. Overflow never holds it.
