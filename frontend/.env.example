# Base URL of the Overflow backend.
# Everything secret (Jupiter API key, RPC credentials) lives on the backend.
# Nothing in this file is a secret: Vite inlines VITE_* values into the bundle.
# Restart `npm run dev` or run `npm run build` after changing this.
VITE_API_BASE=http://localhost:8787/api

# Block explorer used for transaction links in receipts.
VITE_EXPLORER_BASE=https://solscan.io/tx

# solana:mainnet or solana:devnet for wallet transaction signing.
# Set to devnet when the Overflow registry program is deployed there.
VITE_SOLANA_CLUSTER=mainnet
